# Copy to .env.local and fill in real values. Never commit real credentials.

# PostgreSQL. Local Docker (npm run db:up) or your hosted database (e.g. Supabase pooler URL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synchub

# Public origin printed into table QR codes and used for payment return URLs
# (defaults to the host serving the page)
# GUEST_ORDER_ORIGIN=https://order.example.com

# PayMongo online payments (GCash, Maya, cards). Get keys at https://dashboard.paymongo.com/developers
# Leave empty to disable online payment (customers can still pay cash).
PAYMONGO_SECRET_KEY=
# Signing secret of the webhook you create for checkout_session.payment.paid → https://<your-host>/api/payments/paymongo/webhook
PAYMONGO_WEBHOOK_SECRET=
